476        %macro normalize_effect(var=);
477        	%local _i _effect;
478        	%let _i=1;
479        	%do %while(%scan(&pr2_class_vars, &_i) ne );
480        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
481        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
482        		%let _i=%eval(&_i + 1);
483        	%end;
484        %mend;
