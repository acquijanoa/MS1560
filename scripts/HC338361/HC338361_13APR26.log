458        %macro normalize_effect(var=);
459        	%local _i _effect;
460        	%let _i=1;
461        	%do %while(%scan(&pr2_class_vars, &_i) ne );
462        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
463        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
464        		%let _i=%eval(&_i + 1);
465        	%end;
466        %mend;
467        
468        * Fit the models using the imputed data;
469        title 'Model 1 - Sociodemographics';
470        proc genmod data = &impdb;
471        	by _imputation_;
472        	class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN') marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
473        			education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO") yrsus_c3(ref='US_BORN');
474        	model bmiz = centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3 parity_v1 employedyn marital_status yrsus_c3 / d=normal;
475        	format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt.
476        			employedyn employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
477        	ods output ParameterEstimates=genmod_results_1;
478        run;

