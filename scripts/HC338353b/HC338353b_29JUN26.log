151        
152        * Post-process: collapse covariates and categorize hei2010 and slpdur;
153        data data.&impds.;
154        	set data.&impds.;
155        
156        	if not missing(bkgrd1_c7nomiss) then do;
157        		if bkgrd1_c7nomiss = 3 then bkgrd1_c3nomiss = 1;
158        		else if bkgrd1_c7nomiss in (0, 2, 4) then bkgrd1_c3nomiss = 2;
159        		else if bkgrd1_c7nomiss in (1, 5, 6) then bkgrd1_c3nomiss = 3;
160        	end;
161        	else bkgrd1_c3nomiss = .;
162        
163        	if not missing(marital_status) then do;
164        		if marital_status in (1, 3) then marital_status_c2 = 1;
165        		else if marital_status = 2 then marital_status_c2 = 2;
166        	end;
167        	else marital_status_c2 = .;
168        
169        	if not missing(cigarette_use) then do;
170        		if cigarette_use = 1 then cigarette_use_c2 = 1;
The SAS System

171        		else if cigarette_use in (2, 3) then cigarette_use_c2 = 2;
172        	end;
173        	else cigarette_use_c2 = .;
174        
175        	label bkgrd1_c3nomiss = 'Hispanic/Latino background (3 categories)';
176        	label marital_status_c2 = 'Marital status (2 categories)';
177        	label cigarette_use_c2 = 'Cigarette use (never vs current or former)';
178        
179        	if missing(SLPDUR) then SLPDUR_LT8HRS = .;
180        	else if SLPDUR < 8 then SLPDUR_LT8HRS = 1;
181        	else SLPDUR_LT8HRS = 0;
182        	label SLPDUR_LT8HRS = 'Sleep duration (<8 hours)';
183        
184        	if HEI2010 <= 50.1 then HEI2010_C3 = 1;
185        	else if HEI2010 > 50.1 and HEI2010 <= 62.5 then HEI2010_C3 = 2;
186        	else if HEI2010 > 62.5 then HEI2010_C3 = 3;
187        	label HEI2010_C3 = '3-level Health Index Score 2010';
188        run;

