469        %macro normalize_effect(var=);
470        	%local _i _effect;
471        	%let _i=1;
472        	%do %while(%scan(&pr2_class_vars, &_i) ne );
473        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
474        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
475        		%let _i=%eval(&_i + 1);
476        	%end;
477        %mend;
