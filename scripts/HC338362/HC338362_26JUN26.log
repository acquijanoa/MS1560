526        %macro normalize_effect(var=);
527        	%local _i _effect;
528        	%let _i=1;
529        	%do %while(%scan(&pr2_class_vars, &_i) ne );
530        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
531        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
532        		%let _i=%eval(&_i + 1);
533        	%end;
534        %mend;
