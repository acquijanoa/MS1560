470        %macro normalize_effect(var=);
471        	%local _i _effect;
472        	%let _i=1;
473        	%do %while(%scan(&pr2_class_vars, &_i) ne );
474        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
475        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
476        		%let _i=%eval(&_i + 1);
477        	%end;
478        %mend;
