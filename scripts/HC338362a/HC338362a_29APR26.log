483        proc genmod data=&impdb;
484        	by _imputation_;
485        	class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN')
486        		marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
487        		education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO")
488        		yrsus_c3(ref='US_BORN');
489        	model waz=centernum yrs_btwn_v1flor age haz bkgrd1_c7nomiss n_hc education_c3
490        		parity_v1 employedyn marital_status yrsus_c3 / d=normal ;
491        	format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss
492        		bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn
493        		employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
494        	ods output ParameterEstimates=genmod_results_1;
495        run;

