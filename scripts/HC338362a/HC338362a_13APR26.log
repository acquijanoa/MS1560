451        
452        * define macro variables;
453        %let pr2_class_vars=bkgrd1_c7nomiss marital_status employedyn education_c3 n_hc
454        	yrsus_c3 current_smoker alcohol_use pag2008yn hei2010_c3 cesd10 stai10
455        	centernum;
456        %let pr2_cont_vars=age haz parity_v1 slpdur child_prs_bmi_a yrs_btwn_v1flor;
457        %let pr2_table_vars=&pr2_cont_vars centernum;
458        
459        %macro normalize_effect(var=);
460        	%local _i _effect;
461        	%let _i=1;
462        	%do %while(%scan(&pr2_class_vars, &_i) ne );
463        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
464        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
465        		%let _i=%eval(&_i + 1);
466        	%end;
467        %mend;
468        
469        * Fit the models using the imputed data;
470        title 'Model 1 - Sociodemographics';
471        
472        proc genmod data=&impdb;
473        	by _imputation_;
474        	class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN')
475        		marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
476        		education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO")
477        		yrsus_c3(ref='US_BORN');
478        	model waz=centernum yrs_btwn_v1flor age haz bkgrd1_c7nomiss n_hc education_c3
479        		parity_v1 employedyn marital_status yrsus_c3 / d=normal ;
480        	format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss
481        		bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn
482        		employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
483        	ods output ParameterEstimates=genmod_results_1;
484        run;

