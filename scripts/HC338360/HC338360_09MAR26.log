346            set &impdb.;
347        
348            if BMIPCT_C3 in (2,3) then BMIPCT_C2 = 1;
                                                                               The SAS System

349            else if BMIPCT_C3 = 1 then BMIPCT_C2 = 0;
350            else BMIPCT_C2 = .;
351            label BMIPCT_C2 = 'Respondent is Overweight or Obese';
352        run;

