302        
303        * Macro to process imputed odds ratios;
304        %macro process_imputed_or(in_db=, out_db=, model=);
305            data &in_db.;
306                set &in_db.;
307                length EffectName $50;
308                if missing(Level1) then EffectName = Parameter;
309                else EffectName = catx('_', Parameter, Level1);
310            run;
311        
312            proc sort data = &in_db.;
313                by EffectName;
314            run;
315        
316            ods output ParameterEstimates = &out_db._p;
317            proc mianalyze data = &in_db.;
318                by EffectName;
319                modeleffects Estimate;
320                stderr StdErr;
321            run;
322            ods output close;
323        
324            data &out_db.(keep = order model label or_txt ci_txt pv);
325                length model $10 or_txt $20 ci_txt $30;
326                set &out_db._p(rename = (EffectName = variable));
327                model = &model.;
328        
329                %labels;
330                if variable not in ('Scale','Intercept');
331        
332                if std = 99 then do;
333                    or_txt = 'Ref.';
334                    ci_txt = ' ';
335                end;
336                else do;
337                    or_txt = strip(put(exp(estimate), 8.2));
338                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
339                                   strip(put(exp(UCLMean), 8.2)), ')');
340                end;
341            run;
342        %mend process_imputed_or;
