373        proc sql;
374        	create table ame_all as
375        	select c.EffectName,
376        		   mean( p * (1 - p) * c.Estimate ) as AME
377        	from res_with_p r
378        	inner join coef4 c
379        		on r._imputation_ = c._imputation_
380        	where upcase(c.ParmName) not in ('SCALE','INTERCEPT')
381        	group by c.EffectName;
