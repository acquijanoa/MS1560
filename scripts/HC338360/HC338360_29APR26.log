388        
389        %macro process_imputed2(in_db=, out_db=, model=);
390        
391        	* Reshape the dataset to include effect names;
392        	data &in_db.;
393        	    set &in_db.;
394        	    length ParmName $32 EffectName $50;
395        	    /* Harmonize parameter naming with GEEEmpPEst (Parm or Parameter) */
396        	    ParmName = coalescec(Parm, Parameter);
397        	    if missing(Level1) then EffectName = ParmName;
398        	    else EffectName = catx('_', ParmName, Level1);
399        	run;
400        
401        	* Sort the dataset by effect name;
402        	proc sort data = &in_db.; by Effectname; run;
403        
404        	* Combine estimates in the imputated dataset using Rubin method in MiAnalize;
405        	ods output ParameterEstimates = &out_db._p;
406        	proc mianalyze data=&in_db.;
                                                                               The SAS System

407        	    by EffectName;
408        	    modeleffects Estimate;
409        	    stderr StdErr;
410        	run;
411        	ods output close;
412        
413        	data &out_db.;
414        	 	set &out_db._p(keep=EffectName estimate StdErr Probt
415        						rename=(EffectName=variable));
416        		model = "Model &model.";
417        		%labels;
418        		if variable not in ('Scale','Intercept');
419        	run;
420        
421        %mend process_imputed2;
422        
423        * call the macro;
424        %process_imputed2(in_db = genmod_results_1, out_db = mianalize_1, model = 1);

