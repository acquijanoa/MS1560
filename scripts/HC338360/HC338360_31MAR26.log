361        proc sql;
362        	create table ame_all as
363        	select c.EffectName,
364        		   mean( p * (1 - p) * c.Estimate ) as AME
365        	from res_with_p r
366        	inner join coef4 c
367        		on r._imputation_ = c._imputation_
368        	where upcase(c.ParmName) not in ('SCALE','INTERCEPT')
369        	group by c.EffectName;
