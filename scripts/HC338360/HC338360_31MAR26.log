346        * Average Marginal Effects (Model 4, logit link): AME = E[p(1-p) * beta_i];
347        * where p = logistic(X*beta) is the mean of BMIPCT/100.;
348        data coef4;
349        	set genmod_results_4;
350        	length ParmName $32 EffectName $50;
351        	ParmName = coalescec(Parm, Parameter);
352        	if missing(Level1) then EffectName = ParmName;
353        	else EffectName = catx('_', ParmName, Level1);
354        run;

