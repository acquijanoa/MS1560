377        %macro process_imputed2(in_db=, out_db=, model=);
378        
379        	* Reshape the dataset to include effect names;
380        	data &in_db.;
381        	    set &in_db.;
382        	    length ParmName $32 EffectName $50;
383        	    /* Harmonize parameter naming with GEEEmpPEst (Parm or Parameter) */
384        	    ParmName = coalescec(Parm, Parameter);
385        	    if missing(Level1) then EffectName = ParmName;
386        	    else EffectName = catx('_', ParmName, Level1);
387        	run;
388        
389        	* Sort the dataset by effect name;
390        	proc sort data = &in_db.; by Effectname; run;
391        
392        	* Combine estimates in the imputated dataset using Rubin method in MiAnalize;
393        	ods output ParameterEstimates = &out_db._p;
394        	proc mianalyze data=&in_db.;
395        	    by EffectName;
396        	    modeleffects Estimate;
397        	    stderr StdErr;
                                                                               The SAS System

398        	run;
399        	ods output close;
400        
401        	data &out_db.;
402        	 	set &out_db._p(keep=EffectName estimate StdErr Probt
403        						rename=(EffectName=variable));
404        		model = "Model &model.";
405        		%labels;
406        		if variable not in ('Scale','Intercept');
407        	run;
408        
409        %mend process_imputed2;
410        
411        * call the macro;
412        %process_imputed2(in_db = genmod_results_1, out_db = mianalize_1, model = 1);

