631        * Significance: 95% Wald CI on OR scale excludes 1. Keep flags for PROC REPORT styling;
632        data db_join;
633        	length statsOW statsOB statsOBvsOW $168;
634        	length lc2 uc2 lc3 uc3 lc32 uc32 8;
635        	set db_join;
636        	call missing(lc2, uc2, lc3, uc3, lc32, uc32);
637        	sigOW = 0;
638        	sigOB = 0;
639        	sigOBvsOW = 0;
640        	if nmiss(Estimate2, StdErr2) = 0 then do;
641        		z = Estimate2 - 1.96 * StdErr2;
642        		if z > 709 then lc2 = .;
643        		else if z < -745 then lc2 = 0;
644        		else lc2 = exp(z);
645        		z = Estimate2 + 1.96 * StdErr2;
646        		if z > 709 then uc2 = .;
647        		else if z < -745 then uc2 = 0;
648        		else uc2 = exp(z);
649        	end;
650        	if nmiss(Estimate3, StdErr3) = 0 then do;
651        		z = Estimate3 - 1.96 * StdErr3;
652        		if z > 709 then lc3 = .;
653        		else if z < -745 then lc3 = 0;
654        		else lc3 = exp(z);
655        		z = Estimate3 + 1.96 * StdErr3;
656        		if z > 709 then uc3 = .;
657        		else if z < -745 then uc3 = 0;
658        		else uc3 = exp(z);
659        	end;
660        	if nmiss(Estimate2, StdErr2, Estimate3, StdErr3) = 0 then do;
661        		diff32 = Estimate3 - Estimate2;
662        		se32 = sqrt(StdErr2 ** 2 + StdErr3 ** 2);
663        		z = diff32 - 1.96 * se32;
664        		if z > 709 then lc32 = .;
665        		else if z < -745 then lc32 = 0;
666        		else lc32 = exp(z);
667        		z = diff32 + 1.96 * se32;
668        		if z > 709 then uc32 = .;
669        		else if z < -745 then uc32 = 0;
670        		else uc32 = exp(z);
671        	end;
672        	if nmiss(lc2, uc2) = 0 then sigOW = (lc2 > 1) | (uc2 < 1);
673        	if nmiss(lc3, uc3) = 0 then sigOB = (lc3 > 1) | (uc3 < 1);
674        	if nmiss(lc32, uc32) = 0 then sigOBvsOW = (lc32 > 1) | (uc32 < 1);
675        	drop lc2 uc2 lc3 uc3 lc32 uc32 z diff32 se32;
