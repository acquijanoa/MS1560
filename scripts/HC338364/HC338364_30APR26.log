281        
282        * Process imputed estimates (ordinal): keep intercept cut-points;
283        %macro process_imputed_ord(in_db=, out_db=, model=);
284        	data &in_db.;
285        	    set &in_db.;
286        	    length EffectName $50;
287        	    if missing(Level1) then EffectName = Parameter;
288        	    else EffectName = catx('_', Parameter, Level1);
289        	run;
290        
291        	proc sort data = &in_db.;
292        		by EffectName;
293        	run;
294        
295        	ods output ParameterEstimates = &out_db._p;
296        	proc mianalyze data=&in_db.;
297        	    by EffectName;
298        	    modeleffects Estimate;
299        	    stderr StdErr;
300        	run;
301        	ods output close;
302        
303        	data &out_db.;
304        	 	set &out_db._p(keep=EffectName estimate StdErr Probt
305        						rename=(EffectName=variable));
306        		model = "Model &model.";
307        		%labels;
308        		if upcase(variable) = 'SCALE' then delete;
309        		if upcase(variable) = 'INTERCEPT' then label = 'Intercept 1';
310        		else if index(upcase(variable), 'INTERCEPT_') = 1 then do;
311        			if scan(variable, -1, '_') = '2' then label = 'Intercept 2';
312        			else if scan(variable, -1, '_') = '1' then label = 'Intercept 1';
313        			else label = 'Intercept';
314        		end;
315        	run;
316        %mend process_imputed_ord;
317        
318        * Fit the models using the imputed data;
319        title 'Model 1 - Sociodemographics (Ordinal Cumulative Logit)';
320        proc genmod data = &impdb.;
321        	by _imputation_;
322        	class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN') marital_status(ref='SINGLE')
323        		employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO")
324        		yrsus_c3(ref='US_BORN') BMIPCT_C3(ref='Normal');
325        	model BMIPCT_C3 = centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3
326        		parity_v1 employedyn marital_status yrsus_c3 / dist=multinomial link=cumlogit;
327        	format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt.
328        		marital_status marital_status_fmt. employedyn employedyn_fmt. yrsus_c3 yrsus_c3_fmt.
                                                                               The SAS System

329        		education_c3 education_c3_fmt. BMIPCT_C3 bmipct_c3_fmt.;
330        	ods output ParameterEstimates = genmod_results_1;
331        	where keep_ms1560;
332        run;

