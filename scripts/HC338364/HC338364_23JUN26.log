593        
594        * Significance: 95% Wald CI on OR scale excludes 1. Keep flags for PROC REPORT styling;
595        data db_join;
596        	length statsOW statsOB statsOBvsOW $168;
597        	length lc2 uc2 lc3 uc3 lc32 uc32 8;
598        	set db_join;
599        	call missing(lc2, uc2, lc3, uc3, lc32, uc32);
600        	sigOW = 0;
601        	sigOB = 0;
602        	sigOBvsOW = 0;
603        	if nmiss(Estimate2, StdErr2) = 0 then do;
604        		z = Estimate2 - 1.96 * StdErr2;
605        		if z > 709 then lc2 = .;
606        		else if z < -745 then lc2 = 0;
607        		else lc2 = exp(z);
608        		z = Estimate2 + 1.96 * StdErr2;
609        		if z > 709 then uc2 = .;
610        		else if z < -745 then uc2 = 0;
611        		else uc2 = exp(z);
612        	end;
613        	if nmiss(Estimate3, StdErr3) = 0 then do;
614        		z = Estimate3 - 1.96 * StdErr3;
615        		if z > 709 then lc3 = .;
616        		else if z < -745 then lc3 = 0;
617        		else lc3 = exp(z);
618        		z = Estimate3 + 1.96 * StdErr3;
619        		if z > 709 then uc3 = .;
620        		else if z < -745 then uc3 = 0;
621        		else uc3 = exp(z);
622        	end;
623        	if nmiss(Estimate2, StdErr2, Estimate3, StdErr3) = 0 then do;
624        		diff32 = Estimate3 - Estimate2;
625        		se32 = sqrt(StdErr2 ** 2 + StdErr3 ** 2);
626        		z = diff32 - 1.96 * se32;
627        		if z > 709 then lc32 = .;
628        		else if z < -745 then lc32 = 0;
629        		else lc32 = exp(z);
630        		z = diff32 + 1.96 * se32;
631        		if z > 709 then uc32 = .;
632        		else if z < -745 then uc32 = 0;
633        		else uc32 = exp(z);
634        	end;
635        	if nmiss(lc2, uc2) = 0 then sigOW = (lc2 > 1) | (uc2 < 1);
636        	if nmiss(lc3, uc3) = 0 then sigOB = (lc3 > 1) | (uc3 < 1);
637        	if nmiss(lc32, uc32) = 0 then sigOBvsOW = (lc32 > 1) | (uc32 < 1);
638        	drop lc2 uc2 lc3 uc3 lc32 uc32 z diff32 se32;
639        run;

