295        * --- Model 4 only: multinomial logistic (generalized logit), reference = Normal;
296        title 'Model 4 (complete): Multinomial logistic (generalized logit)';
297        proc logistic data = logistic_input plots=none;
298        	by _imputation_;
299        	class BMIPCT_C3(ref='Normal') centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN')
300        		marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
301        		education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO") yrsus_c3(ref='US_BORN')
302        		cigarette_use(ref="NEVER") alcohol_use(ref="NEVER") pag2008yn(ref="YES")
303        		hei2010_c3(ref="LOW") cesd10(ref="NODEPRE") stai10(ref="NOANX") / param = ref;
304        	model BMIPCT_C3 = centernum yrs_btwn_v1flor age n_hc education_c3 parity_v1
305        		employedyn marital_status yrsus_c3 cigarette_use hei2010_c3 alcohol_use pag2008yn slpdur
306        		cesd10 stai10 child_prs_bmi_a / link = glogit expb clodds = wald covb;
307        	format BMIPCT_C3 bmipct_c3_fmt. centernum centernum_fmt. n_hc n_hc_fmt.
308        		bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt.
309        		employedyn employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.
310        		alcohol_use alcohol_use_fmt. cigarette_use cigarette_use_fmt. pag2008yn yn_fmt.
311        		hei2010_c3 hei2010_c3_fmt. cesd10 cesd10_fmt. stai10 stai10_fmt.;
312        	ods output ParameterEstimates = estimate_raw CovB = covb_raw;
313        run;

