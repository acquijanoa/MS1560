282        
283        * Process imputed estimates (ordinal): keep intercept cut-points;
284        %macro process_imputed_ord(in_db=, out_db=, model=);
285        	data &in_db.;
286        	    set &in_db.;
287        	    length EffectName $50;
288        	    if missing(Level1) then EffectName = Parameter;
289        	    else EffectName = catx('_', Parameter, Level1);
290        	run;
291        
292        	proc sort data = &in_db.;
293        		by EffectName;
294        	run;
295        
296        	ods output ParameterEstimates = &out_db._p;
297        	proc mianalyze data=&in_db.;
298        	    by EffectName;
299        	    modeleffects Estimate;
300        	    stderr StdErr;
301        	run;
302        	ods output close;
303        
304        	data &out_db.;
305        	 	set &out_db._p(keep=EffectName estimate StdErr Probt
306        						rename=(EffectName=variable));
307        		model = "Model &model.";
308        		%labels;
309        		if upcase(variable) = 'SCALE' then delete;
310        		if upcase(variable) = 'INTERCEPT' then label = 'Intercept 1';
311        		else if index(upcase(variable), 'INTERCEPT_') = 1 then do;
312        			if scan(variable, -1, '_') = '2' then label = 'Intercept 2';
313        			else if scan(variable, -1, '_') = '1' then label = 'Intercept 1';
314        			else label = 'Intercept';
315        		end;
316        	run;
317        %mend process_imputed_ord;
