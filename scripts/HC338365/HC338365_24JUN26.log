322        
323        /* Macro to process imputed odds ratios (proportional odds; same structure as job 58 / HC338358) */
324        %macro process_imputed_or(in_db=, out_db=, model=);
325        	data &in_db.;
326        	    set &in_db.;
327        	    length EffectName $50;
328        	    if missing(Level1) then EffectName = Parameter;
329        	    else EffectName = catx('_', Parameter, Level1);
330        	run;
331        
332        	proc sort data = &in_db.;
333        	    by EffectName;
334        	run;
335        
336        	ods output ParameterEstimates = &out_db._p;
337        	proc mianalyze data = &in_db.;
338        	    by EffectName;
339        	    modeleffects Estimate;
340        	    stderr StdErr;
341        	run;
342        	ods output close;
343        
344        	data &out_db.(keep = order model label or_txt ci_txt pv);
345        	    length model $10 or_txt $20 ci_txt $30;
346        	    set &out_db._p(rename = (EffectName = variable));
347        	    model = &model.;
348        	    %labels;
349        	    if upcase(variable) = 'SCALE' then delete;
350        	    if upcase(variable) =: 'INTERCEPT' then delete;
351        
352        	    if std = 99 then do;
353        	        or_txt = 'Ref.';
354        	        ci_txt = ' ';
355        	    end;
356        	    else do;
357        	        or_txt = strip(put(exp(estimate), 8.2));
358        	        ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
359        	                       strip(put(exp(UCLMean), 8.2)), ')');
360        	    end;
361        	run;
362        %mend process_imputed_or;
