286        
287        /* Macro to process imputed odds ratios (proportional odds; same structure as job 58 / HC338358) */
288        %macro process_imputed_or(in_db=, out_db=, model=);
289        	data &in_db.;
290        	    set &in_db.;
291        	    length EffectName $50;
292        	    if missing(Level1) then EffectName = Parameter;
293        	    else EffectName = catx('_', Parameter, Level1);
294        	run;
295        
296        	proc sort data = &in_db.;
297        	    by EffectName;
298        	run;
299        
300        	ods output ParameterEstimates = &out_db._p;
301        	proc mianalyze data = &in_db.;
302        	    by EffectName;
303        	    modeleffects Estimate;
304        	    stderr StdErr;
305        	run;
306        	ods output close;
307        
308        	data &out_db.(keep = order model label or_txt ci_txt pv);
309        	    length model $10 or_txt $20 ci_txt $30;
310        	    set &out_db._p(rename = (EffectName = variable));
311        	    model = &model.;
312        	    %labels;
313        	    if upcase(variable) = 'SCALE' then delete;
314        	    if upcase(variable) =: 'INTERCEPT' then delete;
315        
316        	    if std = 99 then do;
317        	        or_txt = 'Ref.';
318        	        ci_txt = ' ';
319        	    end;
320        	    else do;
321        	        or_txt = strip(put(exp(estimate), 8.2));
322        	        ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
323        	                       strip(put(exp(UCLMean), 8.2)), ')');
324        	    end;
                                                                               The SAS System

325        	run;
326        %mend process_imputed_or;
