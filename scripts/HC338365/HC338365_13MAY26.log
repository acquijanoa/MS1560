328        * Fit the models using the imputed data;
329        title 'Model 1 - Sociodemographics (Ordinal Cumulative Logit)';
330        proc genmod data = &impdb. order=data;
331        	by _imputation_;
332        	class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN') marital_status(ref='SINGLE')
333        		employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO")
334        		yrsus_c3(ref='US_BORN') BMIPCT_C3(ref='Normal');
335        	model BMIPCT_C3 = centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3
336        		parity_v1 employedyn marital_status yrsus_c3 / dist=multinomial link=cumlogit;
337        	format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt.
338        		marital_status marital_status_c2_fmt. employedyn employedyn_fmt. yrsus_c3 yrsus_c3_fmt.
339        		education_c3 education_c3_fmt. BMIPCT_C3 bmipct_c3_fmt.;
340        	ods output ParameterEstimates = genmod_results_1;
341        	where keep_ms1560;
342        run;

