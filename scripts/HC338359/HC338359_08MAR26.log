256        
257        %macro process_imputed_or(in_db=, out_db=, model=);
258        
259        	data &in_db.;
260        		set &in_db.;
261        		length EffectName $50;
262        		if missing(Level1) then EffectName = Parameter;
263        		else EffectName = catx('_', Parameter, Level1);
264        	run;
265        
266        	proc sort data=&in_db.; by EffectName; run;
267        
268        	ods output ParameterEstimates=&out_db._p;
269        	proc mianalyze data=&in_db.;
270        		by EffectName;
271        		modeleffects Estimate;
272        		stderr StdErr;
273        	run;
274        	ods output close;
275        
276        	data &out_db.;
277        		length model $10 or_txt $20 ci_txt $30;
278        		set &out_db._p(rename=(EffectName=variable));
279        		model = "Model &model.";
280        
281        		* Handle CI variable names across MIANALYZE outputs;
282        		lcl = inputn(strip(coalescec(vvaluex('LCLMean'), vvaluex('Lower'))), best32.);
283        		ucl = inputn(strip(coalescec(vvaluex('UCLMean'), vvaluex('Upper'))), best32.);
284        
285        		%labels;
286        		if variable not in ('Scale', 'Intercept');
287        
288        		if std = 99 then do;
289        			or_txt = 'Ref.';
290        			ci_txt = ' ';
291        		end;
292        		else do;
293        			or_txt = strip(put(exp(estimate), 8.2));
294        			ci_txt = cats('(', strip(put(exp(lcl), 8.2)), ', ', strip(put(exp(ucl), 8.2)), ')');
295        		end;
296        	run;
297        
298        %mend process_imputed_or;
