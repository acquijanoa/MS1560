258        
259        %macro process_imputed_or(in_db=, out_db=, model=);
260        
261        	data &in_db.;
262        		set &in_db.;
263        		length EffectName $50;
264        		if missing(Level1) then EffectName=Parameter;
265        		else EffectName=catx('_', Parameter, Level1);
266        	run;
267        
268        	proc sort data=&in_db.;
269        		by EffectName;
270        	run;
271        
272        	ods output ParameterEstimates=&out_db._p;
273        
274        	proc mianalyze data=&in_db.;
275        		by EffectName;
276        		modeleffects Estimate;
277        		stderr StdErr;
278        	run;
279        	ods output close;
280        
281        	data &out_db.;
282        		length model $10 or_txt $20 ci_txt $30;
283        		set &out_db._p(rename=(EffectName=variable));
284        		model="Model &model.";
285        
286        		* Handle CI variable names across MIANALYZE outputs;
287        		lcl=inputn(strip(vvaluex('LCLMean')), best32.);
288        		if missing(lcl) then lcl=inputn(strip(vvaluex('Lower')), best32.);
289        		ucl=inputn(strip(vvaluex('UCLMean')), best32.);
290        		if missing(ucl) then ucl=inputn(strip(vvaluex('Upper')), best32.);
291        
292        		%labels;
293        		if variable not in ('Scale', 'Intercept');
294        
295        		if std=99 then do;
296        			or_txt='Ref.';
297        			ci_txt=' ';
298        		end;
299        		else do;
300        			or_txt=strip(put(exp(estimate), 8.2));
301        			ci_txt=cats('(', strip(put(exp(lcl), 8.2)), ', ',
302        				strip(put(exp(ucl), 8.2)), ')');
303        		end;
304        	run;
305        
                                                                               The SAS System

306        %mend process_imputed_or;
