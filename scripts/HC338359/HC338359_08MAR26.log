257        
258        * Define macro to process imputed ORs;
259        %macro process_imputed_or(in_db=, out_db=, model=);
260        	data &in_db.;
261        		set &in_db.;
262        		length EffectName $50;
263        		if missing(Level1) then EffectName=Parameter;
264        		else EffectName=catx('_', Parameter, Level1);
265        	run;
266        	proc sort data=&in_db.;
267        		by EffectName;
268        	run;
269        
270        	ods output ParameterEstimates=&out_db._p;
271        	proc mianalyze data=&in_db.;
272        		by EffectName;
273        		modeleffects Estimate;
274        		stderr StdErr;
275        	run;
276        	ods output close;
277        
278        	data &out_db.(keep=order model label or_txt ci_txt pv);
279        		length model $10 or_txt $20 ci_txt $30;
280        		set &out_db._p(rename=(EffectName=variable));
281        		model=&model.;
282        		
283        		%labels;
284        		if variable not in ('Scale', 'Intercept');
285        
286        		if std=99 then do;
287        			or_txt='Ref.';
288        			ci_txt=' ';
289        		end;
290        		else do;
291        			or_txt=strip(put(exp(estimate), 8.2));
292        			ci_txt=cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
293        				strip(put(exp(UCLMean), 8.2)), ')');
294        		end;
295        run;
296        %mend process_imputed_or;
