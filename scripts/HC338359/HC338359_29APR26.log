467        %macro normalize_effect(var=);
468        	%local _i _effect;
469        	%let _i=1;
470        	%do %while(%scan(&pr2_class_vars, &_i) ne );
471        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
472        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
473        		%let _i=%eval(&_i + 1);
474        	%end;
475        %mend;
