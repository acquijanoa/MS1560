258        
259        * Define macro to process imputed ORs;
260        %macro process_imputed_or(in_db=, out_db=, model=);
261        	data &in_db.;
262        		set &in_db.;
263        		length EffectName $50;
264        		if missing(Level1) then EffectName=Parameter;
265        		else EffectName=catx('_', Parameter, Level1);
266        	run;
267        
268        	proc sort data=&in_db.;
269        		by EffectName;
270        	run;
271        
272        	ods output ParameterEstimates=&out_db._p;
273        
274        	proc mianalyze data=&in_db.;
275        		by EffectName;
276        		modeleffects Estimate;
277        		stderr StdErr;
278        	run;
279        	ods output close;
280        
281        	data &out_db.(keep=order model label or_txt ci_txt pv);
282        		length model $10 or_txt $20 ci_txt $30;
283        		set &out_db._p(rename=(EffectName=variable));
284        		model=&model.;
285        
286        		%labels;
287        		if variable not in ('Scale', 'Intercept');
288        
289        		if std=99 then do;
290        			or_txt='Ref.';
291        			ci_txt=' ';
292        		end;
293        		else do;
294        			or_txt=strip(put(exp(estimate), 8.2));
295        			ci_txt=cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
296        				strip(put(exp(UCLMean), 8.2)), ')');
297        		end;
298        	run;
299        %mend process_imputed_or;
