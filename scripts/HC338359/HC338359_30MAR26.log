450        %macro normalize_effect(var=);
451        	%local _i _effect;
452        	%let _i=1;
453        	%do %while(%scan(&pr2_class_vars, &_i) ne );
454        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
455        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
456        		%let _i=%eval(&_i + 1);
457        	%end;
458        %mend;
