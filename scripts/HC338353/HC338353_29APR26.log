146        * categorize hei2010 and slpdur - 12nov25;
147        data data.&job._imputed_data_&sysdate.;
148        	set data.&job._imputed_data_&sysdate.;
149        
150        	* SLPDUR_L8HRS;
151        	if missing(SLPDUR) then SLPDUR_LT8HRS = .;
152        	else if SLPDUR < 8 then SLPDUR_LT8HRS = 1;
153        	else SLPDUR_LT8HRS = 0;
154        	label SLPDUR_LT8HRS = 'Sleep duration (<8 hours)';
155        
156        	* HEI2010_C3;
157        	if HEI2010 <= 50.1 then HEI2010_C3 = 1;
158        	else if HEI2010 > 50.1 and HEI2010 <= 62.5 then HEI2010_C3 = 2;
159        	else if HEI2010 > 62.5 then HEI2010_C3 = 3;
160        	label HEI2010_C3 = '3-level Health Index Score 2010';
161        
162        run;

