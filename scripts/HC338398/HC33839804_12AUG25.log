102        
103        * Freqs;
104        %macro freqs(var=);
105        	ods startpage = on;
106         * Print frequencies;
107        	ods rtf select none;
108        	proc freq data = &db_all.;
109        		table &var. * flor_dyad / norow nopercent chisq out=tab_freq;
110        		format flor_dyad flor_dyad_fmt. &var. &var._fmt.;
111        		ods output  CrossTabFreqs = tab_freqs0
112        						ChisQ = tab_p0;
113        	run;
114        	data tab_freqs;
115        		set tab_freqs0;
116        		drop table _table_ _type_ missing;
117        
118        		rename colpercent=percent;
119        		if _type_ = '11';
120        		colpercent = colpercent / 100;
121        	run;
122        	ods rtf select all;
123        	proc report data = tab_freqs;
124        		title2 "&var.";
125        		column &var. flor_dyad,(Frequency Percent);
126        		define &var. / group 'Row var';
127         		define flor_dyad / across '';
128        		define Frequency / analysis 'N' format=8.2;
129        		define Percent / analysis 'Percent' format=percent8.1;
130        	run;
131        	ods startpage=no;
132         * Print p-value;
133        	data tab_p;
134        		set tab_p0;
135        		keep variable prob;
136        		if statistic = 'Chi-Square';	
137        		variable = 'P value';
138        	run;
139        	proc print data = tab_p;
140        		title2 "&var.";	
141        		title3 'P-value';
142        	run;
143        	ods startpage=now;
144        %mend freqs;
145        
146        * T-test in flor dataset;
147        %macro ttest_flor(var=);
148        	ods startpage = on;
149        	ods rtf select none;
150        	proc ttest data=&db_all. ;
151        		ods noproctitle;
152        		ods select statistics ttests;
153        		class flor_dyad;
                                                                               The SAS System

154        		var &var.;
155        		format flor_dyad flor_dyad_fmt.;
156        		ods output statistics=tab_stats0
157        				ttests=tab_test0;
158        	quit;
159        	* Edit table with statistics;
160        	data tab_stats;
161        		set tab_stats0;
162        		keep rowvar class N Mean StdDev;
163        		rename class=flor_dyad
164        				N=Frequency;
165        		rowvar = "&var.";
166        		if method = "";
167        	run;	
168        	ods rtf select all;
169        	proc report data=tab_stats;
170        		title2 "&var.";
171        		column rowvar flor_dyad,(Frequency Mean StdDev);
172        		define rowvar / group 'Row var';
173         		define flor_dyad / across '';
174        		define mean / analysis 'Mean' format=8.1;
175        		define stdDev / analysis 'StdDev' format=8.1;
176        		define frequency / analysis 'N' format=8.0;
177        	run;
