6000  title2 height=8pt font='times' "Women (V1, SEX=0) aged 18-44 at visit 1";
6001  * Merge V1 and V2;
6002  *  keep women aged 18 to 44 at V1;
6003  *  flag those in V1 but not at V2;
6004  data id_wm_age;
6005      merge invv1.part_derv_inv5(keep=id age sex in=in_a) invv2.part_derv_v2_inv3(keep=id gender_v2 in=in_b);
6006      by id;
6007      if in_b = 1 and in_a = 1 then in_visit_2 = 1;
6008      else if  in_b = 0 then in_visit_2 = 0;
6009  
6010      if (age >= 18 and age <= 44) and in_a;
6011  run;

