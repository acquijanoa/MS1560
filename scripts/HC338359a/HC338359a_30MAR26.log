446        * define macro variables;
447        %let pr2_class_vars=bkgrd1_c7nomiss marital_status employedyn education_c3 n_hc
448        	yrsus_c3 current_smoker alcohol_use pag2008yn hei2010_c3 cesd10 stai10
449        	centernum;
