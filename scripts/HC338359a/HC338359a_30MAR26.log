451        %let pr2_table_vars=&pr2_cont_vars centernum;
452        
453        %macro normalize_effect(var=);
454        	%local _i _effect;
455        	%let _i=1;
456        	%do %while(%scan(&pr2_class_vars, &_i) ne );
457        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
458        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
459        		%let _i=%eval(&_i + 1);
460        	%end;
461        %mend;
