258        
259        %macro process_imputed_or(in_db=, out_db=, model=);
260        	data &in_db.;
261        		set &in_db.;
262        		length EffectName $50;
263        		if missing(Level1) then EffectName=Parameter;
264        		else EffectName=catx('_', Parameter, Level1);
265        	run;
266        
267        	proc sort data=&in_db.;
268        		by EffectName;
269        	run;
270        
271        	ods output ParameterEstimates=&out_db._p;
272        
273        	proc mianalyze data=&in_db.;
274        		by EffectName;
275        		modeleffects Estimate;
276        		stderr StdErr;
277        	run;
278        	ods output close;
279        
280        	data &out_db.(keep=order model label or_txt ci_txt pv);
281        		length model $10 or_txt $20 ci_txt $30;
282        		set &out_db._p(rename=(EffectName=variable));
283        		model=&model.;
284        
285        		%labels;
286        		if variable not in ('Scale', 'Intercept');
287        
288        		if std=99 then do;
289        			or_txt='Ref.';
290        			ci_txt=' ';
291        		end;
292        		else do;
293        			or_txt=strip(put(exp(estimate), 8.2));
294        			ci_txt=cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
295        				strip(put(exp(UCLMean), 8.2)), ')');
296        		end;
297        	run;
298        
299        %mend process_imputed_or;
