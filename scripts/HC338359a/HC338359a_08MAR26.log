256        
257        %macro process_imputed_or(in_db=, out_db=, model=);
258        	data &in_db.;
259        		set &in_db.;
260        		length EffectName $50;
261        		if missing(Level1) then EffectName=Parameter;
262        		else EffectName=catx('_', Parameter, Level1);
263        	run;
264        
265        	proc sort data=&in_db.;
266        		by EffectName;
267        	run;
268        
269        	ods output ParameterEstimates=&out_db._p;
270        	proc mianalyze data=&in_db.;
271        		by EffectName;
272        		modeleffects Estimate;
273        		stderr StdErr;
274        	run;
275        	ods output close;
276        
277        	data &out_db.(keep=order model label or_txt ci_txt pv);
278        		length model $10 or_txt $20 ci_txt $30;
279        		set &out_db._p(rename=(EffectName=variable));
280        		model=&model.;
281        
282        		%labels;
283        		if variable not in ('Scale', 'Intercept');
284        
285        		if std=99 then do;
286        			or_txt='Ref.';
287        			ci_txt=' ';
288        		end;
289        		else do;
290        			or_txt=strip(put(exp(estimate), 8.2));
291        			ci_txt=cats('(', strip(put(exp(LCLMean), 8.2)), ', ', strip(put(exp(UCLMean), 8.2)), ')');
292        		end;
293        	run;
294        
295        %mend process_imputed_or;
