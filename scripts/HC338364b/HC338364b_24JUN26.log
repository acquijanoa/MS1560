346        	model BMIPCT_C3 = centernum yrs_btwn_v1flor bkgrd1_c7nomiss age n_hc education_c3 parity_v1
347        		employedyn marital_status yrsus_c3 cigarette_use hei2010_c3 alcohol_use pag2008yn slpdur
348        		cesd10 stai10 child_prs_bmi_a / link = glogit expb clodds = wald covb;
