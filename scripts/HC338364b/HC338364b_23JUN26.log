308        
309        * --- Model 4 only: multinomial logistic (generalized logit), reference = Normal;
310        title 'Model 4 (complete): Multinomial logistic (generalized logit)';
311        proc logistic data = logistic_input plots=none;
312        	by _imputation_;
313        	class bmipct_c3(ref='Normal') centernum(ref="BRONX") bkgrd1_c3nomiss(ref='MEXICAN')
314        		marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
315        		education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO") yrsus_c3(ref='US_BORN')
316        		cigarette_use(ref="NEVER") alcohol_use(ref="NEVER") pag2008yn(ref="YES")
317        		hei2010_c3(ref="LOW") cesd10(ref="NODEPRE") stai10(ref="NOANX") / param = ref;
318        	model BMIPCT_C3 = centernum yrs_btwn_v1flor bkgrd1_c3nomiss age n_hc education_c3 parity_v1
319        		employedyn marital_status yrsus_c3 cigarette_use hei2010_c3 alcohol_use pag2008yn slpdur
320        		cesd10 stai10 child_prs_bmi_a / link = glogit expb clodds = wald covb;
321        	format BMIPCT_C3 bmipct_c3_fmt. centernum centernum_fmt. n_hc n_hc_fmt.
322        		bkgrd1_c3nomiss bkgrd1_c3nomiss_fmt. marital_status marital_status_c2_fmt.
323        		employedyn employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.
324        		alcohol_use alcohol_use_fmt. cigarette_use cigarette_use_fmt. pag2008yn yn_fmt.
325        		hei2010_c3 hei2010_c3_fmt. cesd10 cesd10_fmt. stai10 stai10_fmt.;
326        	ods output ParameterEstimates = estimate_raw CovB = covb_raw;
327        run;

