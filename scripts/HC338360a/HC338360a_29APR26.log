426        
427        proc sql;
428        	create table ame_all as
429        	select c.EffectName,
430        		   mean( p * (1 - p) * c.Estimate ) as AME
431        	from res_with_p r
432        	inner join coef4 c
433        		on r._imputation_ = c._imputation_
434        	where upcase(c.ParmName) not in ('SCALE','INTERCEPT')
435        	group by c.EffectName;
NOTE: Table WORK.AME_ALL created, with 44 rows and 2 columns.

