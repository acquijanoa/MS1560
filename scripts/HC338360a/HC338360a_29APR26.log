442        
443        %macro process_imputed2(in_db=, out_db=, model=);
444        
445        	* Reshape the dataset to include effect names;
446        	data &in_db.;
447        	    set &in_db.;
448        	    length ParmName $32 EffectName $50;
449        	    ParmName = coalescec(Parm, Parameter);
                                                                               The SAS System

450        	    if missing(Level1) then EffectName = ParmName;
451        	    else EffectName = catx('_', ParmName, Level1);
452        	run;
453        
454        	* Sort the dataset by effect name;
455        	proc sort data = &in_db.; by Effectname; run;
456        
457        	* Combine estimates in the imputated dataset using Rubin method in MiAnalize;
458        	ods output ParameterEstimates = &out_db._p;
459        	proc mianalyze data=&in_db.;
460        	    by EffectName;
461        	    modeleffects Estimate;
462        	    stderr StdErr;
463        	run;
464        	ods output close;
465        
466        	data &out_db.;
467        	 	set &out_db._p(keep=EffectName estimate StdErr Probt
468        						rename=(EffectName=variable));
469        		model = "Model &model.";
470        		%labels;
471        		if variable not in ('Scale','Intercept');
472        	run;
473        
474        %mend process_imputed2;
475        
476        * call the macro;
477        %process_imputed2(in_db = genmod_results_1, out_db = mianalize_1, model = 1);

