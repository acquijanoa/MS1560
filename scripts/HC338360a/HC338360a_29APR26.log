411        
412        * Average Marginal Effects (Model 4, logit link): AME = E[p(1-p) * beta_i];
413        * where p = logistic(X*beta) is the mean of BMIPCT/100.;
414        data coef4;
415        	set genmod_results_4;
416        	length ParmName $32 EffectName $50;
417        	ParmName = coalescec(Parm, Parameter);
418        	if missing(Level1) then EffectName = ParmName;
419        	else EffectName = catx('_', ParmName, Level1);
420        run;

