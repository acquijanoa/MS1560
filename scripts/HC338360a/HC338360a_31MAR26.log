428        
429        %macro process_imputed2(in_db=, out_db=, model=);
430        
431        	* Reshape the dataset to include effect names;
432        	data &in_db.;
433        	    set &in_db.;
434        	    length ParmName $32 EffectName $50;
435        	    ParmName = coalescec(Parm, Parameter);
436        	    if missing(Level1) then EffectName = ParmName;
437        	    else EffectName = catx('_', ParmName, Level1);
438        	run;
439        
440        	* Sort the dataset by effect name;
                                                                               The SAS System

441        	proc sort data = &in_db.; by Effectname; run;
442        
443        	* Combine estimates in the imputated dataset using Rubin method in MiAnalize;
444        	ods output ParameterEstimates = &out_db._p;
445        	proc mianalyze data=&in_db.;
446        	    by EffectName;
447        	    modeleffects Estimate;
448        	    stderr StdErr;
449        	run;
450        	ods output close;
451        
452        	data &out_db.;
453        	 	set &out_db._p(keep=EffectName estimate StdErr Probt
454        						rename=(EffectName=variable));
455        		model = "Model &model.";
456        		%labels;
457        		if variable not in ('Scale','Intercept');
458        	run;
459        
460        %mend process_imputed2;
461        
462        * call the macro;
463        %process_imputed2(in_db = genmod_results_1, out_db = mianalize_1, model = 1);

