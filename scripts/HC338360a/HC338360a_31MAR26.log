398        * Average Marginal Effects (Model 4, logit link): AME = E[p(1-p) * beta_i];
399        * where p = logistic(X*beta) is the mean of BMIPCT/100.;
400        data coef4;
401        	set genmod_results_4;
402        	length ParmName $32 EffectName $50;
403        	ParmName = coalescec(Parm, Parameter);
404        	if missing(Level1) then EffectName = ParmName;
405        	else EffectName = catx('_', ParmName, Level1);
406        run;

