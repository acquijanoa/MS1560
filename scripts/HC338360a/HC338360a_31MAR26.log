412        
413        proc sql;
414        	create table ame_all as
415        	select c.EffectName,
416        		   mean( p * (1 - p) * c.Estimate ) as AME
417        	from res_with_p r
418        	inner join coef4 c
419        		on r._imputation_ = c._imputation_
420        	where upcase(c.ParmName) not in ('SCALE','INTERCEPT')
421        	group by c.EffectName;
NOTE: Table WORK.AME_ALL created, with 43 rows and 2 columns.

