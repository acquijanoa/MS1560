478        
479        %macro normalize_effect(var=);
480        	%local _i _effect;
481        	%let _i=1;
482        	%do %while(%scan(&pr2_class_vars, &_i) ne );
483        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
484        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
485        		%let _i=%eval(&_i + 1);
486        	%end;
487        %mend;
