472        * define macro variables;
473        %let pr2_class_vars=bkgrd1_c7nomiss marital_status employedyn education_c3 n_hc
474        	yrsus_c3 cigarette_use alcohol_use pag2008yn hei2010_c3 cesd10 stai10
475        	centernum;
