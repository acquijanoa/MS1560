489        * Fit the models using the imputed data;
490        title 'Model 1 - Sociodemographics';
491        
492        proc genmod data=&impdb;
493        	by _imputation_;
494        	class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN')
495        		marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
496        		education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO")
497        		yrsus_c3(ref='US_BORN');
498        	model waz=centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3
499        		parity_v1 employedyn marital_status yrsus_c3 / d=normal ;
500        	format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss
501        		bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn
502        		employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
503        	ods output ParameterEstimates=genmod_results_1;
504        run;

