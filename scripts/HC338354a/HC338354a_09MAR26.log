3011   * Fit the models using the imputed data;
3012   title 'Model 1 - Sociodemographics';
3013   
3014   proc genmod data=&impdb;
3015       by _imputation_;
3016       class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN')
3017           marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
3018           education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO")
3019           yrsus_c3(ref='US_BORN');
3020       model waz=centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3
3021           parity_v1 employedyn marital_status yrsus_c3 / d=normal ;
3022       format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss
3023           bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn
3024           employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
3025       ods output ParameterEstimates=genmod_results_1;
3026   run;

