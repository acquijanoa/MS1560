441        %macro normalize_effect(var=);
442        	%local _i _effect;
443        	%let _i = 1;
444        	%do %while(%scan(&pr2_class_vars, &_i) ne );
445        		%let _effect = %upcase(%scan(&pr2_class_vars, &_i));
446        		if index(&var, cats("&_effect","_")) = 1 then &var = "&_effect";
447        		%let _i = %eval(&_i + 1);
448        	%end;
449        %mend;
