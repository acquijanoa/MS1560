2656   %macro normalize_effect(var=);
2657       %local _i _effect;
2658       %let _i = 1;
2659       %do %while(%scan(&pr2_class_vars, &_i) ne );
2660           %let _effect = %upcase(%scan(&pr2_class_vars, &_i));
2661           if index(&var, cats("&_effect","_")) = 1 then &var = "&_effect";
2662           %let _i = %eval(&_i + 1);
2663       %end;
2664   %mend;
