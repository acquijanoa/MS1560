3001   %macro normalize_effect(var=);
3002       %local _i _effect;
3003       %let _i=1;
3004       %do %while(%scan(&pr2_class_vars, &_i) ne );
3005           %let _effect=%upcase(%scan(&pr2_class_vars, &_i));
3006           if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
3007           %let _i=%eval(&_i + 1);
3008       %end;
3009   %mend;
