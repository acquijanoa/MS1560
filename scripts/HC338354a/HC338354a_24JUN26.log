524        %macro normalize_effect(var=);
525        	%local _i _effect;
526        	%let _i=1;
527        	%do %while(%scan(&pr2_class_vars, &_i) ne );
528        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
529        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
530        		%let _i=%eval(&_i + 1);
531        	%end;
532        %mend;
