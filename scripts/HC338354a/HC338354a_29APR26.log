470        %let pr2_table_vars=&pr2_cont_vars centernum;
471        
472        %macro normalize_effect(var=);
473        	%local _i _effect;
474        	%let _i=1;
475        	%do %while(%scan(&pr2_class_vars, &_i) ne );
476        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
477        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
478        		%let _i=%eval(&_i + 1);
479        	%end;
480        %mend;
481        
482        * Fit the models using the imputed data;
483        title 'Model 1 - Sociodemographics';
484        
485        proc genmod data=&impdb;
486        	by _imputation_;
487        	class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN')
488        		marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
489        		education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO")
490        		yrsus_c3(ref='US_BORN');
491        	model waz=centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3
492        		parity_v1 employedyn marital_status yrsus_c3 / d=normal ;
493        	format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss
494        		bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn
495        		employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
                                                                               The SAS System

496        	ods output ParameterEstimates=genmod_results_1;
497        run;

