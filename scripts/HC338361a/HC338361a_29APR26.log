481        * Fit the models using the imputed data;
482        title 'Model 1 - Sociodemographics';
483        
484        proc genmod data=&impdb;
485        	by _imputation_;
486        	class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN')
487        		marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
488        		education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO")
489        		yrsus_c3(ref='US_BORN');
490        	model bmiz=centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3
491        		parity_v1 employedyn marital_status yrsus_c3 / d=normal ;
492        	format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss
493        		bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn
494        		employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
495        	ods output ParameterEstimates=genmod_results_1;
496        run;

