464        * define macro variables;
465        %let pr2_class_vars=bkgrd1_c7nomiss marital_status employedyn education_c3 n_hc
466        	yrsus_c3 cigarette_use alcohol_use pag2008yn hei2010_c3 cesd10 stai10
467        	centernum;
468        %let pr2_cont_vars=age parity_v1 slpdur child_prs_bmi_a yrs_btwn_v1flor;
469        %let pr2_table_vars=&pr2_cont_vars centernum;
470        
471        %macro normalize_effect(var=);
472        	%local _i _effect;
473        	%let _i=1;
474        	%do %while(%scan(&pr2_class_vars, &_i) ne );
475        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
476        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
477        		%let _i=%eval(&_i + 1);
478        	%end;
479        %mend;
