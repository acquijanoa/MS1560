480        %macro normalize_effect(var=);
481        	%local _i _effect;
482        	%let _i=1;
483        	%do %while(%scan(&pr2_class_vars, &_i) ne );
484        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
485        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
486        		%let _i=%eval(&_i + 1);
487        	%end;
488        %mend;
