181        
182            * use count and pct_row measures from proc freq for calculations;
183            proc freq data=derive2(where=(&denomlogic)) noprint;
184                tables keep_ms1560*&var / missing outpct out=myout(keep=keep_ms1560 &var
185                    count pct_row where=(&var=&varlevel));
186            run;
187        
