186            * use count and pct_row measures from proc freq for calculations;
187            proc freq data=derive2(where=(&denomlogic)) noprint;
188                tables keep_ms1560*&var / missing outpct out=myout(keep=keep_ms1560 &var
189                    count pct_row where=(&var=&varlevel));
190            run;
