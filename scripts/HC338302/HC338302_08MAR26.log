165        * create a single row for a level of a categorical var;
166        %macro categorical(var, varlevel, text, denomlogic, modelpos);
167        
168            * testing;
169            /*
170            %categorical(DEMB1,1,&y Boy, DEMB1 gt .z, 1);
171            %let var= DEMB1;
172            %let varlevel= 1;
173            %let text = %str(&y Boy);
174            %let denomlogic=not missing(DEMB1);
175            %let modelpos= 1;
176             */
177            %model_cat(&var);
178        
179            * use count and pct_row measures from proc freq for calculations;
180            proc freq data=derive2(where=(&denomlogic)) noprint;
181                tables flor_dyad*&var / missing outpct out=myout(keep=flor_dyad &var
182                    count pct_row where=(&var=&varlevel));
183            run;
184        
185            /*format the stats as needed*/
186            data cp;
187                set myout;
188                length cp_n cp_pct $20;
189                cp_n=strip(put(count,8.));
190                cp_pct=strip(put(pct_row,5.1)) || '%';
191            run;
192        
193            /* transpose twice, note use of "suffix" to distinguish */
194            proc transpose data=cp prefix=flor_dyad suffix=_n out=&var.n (drop=_name_);
195                by &var;
