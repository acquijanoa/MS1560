201                (drop=_name_);
202                by &var;
203                id flor_dyad;
204                var cp_pct;
205            run;
206        
207            /*combine and add final touches*/
208            data &var._&varlevel;
209                length vartext $200 var $50;
210                merge &var.n &var.pct;
