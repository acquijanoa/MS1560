173        * create a single row for a level of a categorical var;
174        %macro categorical(var, varlevel, text, denomlogic, modelpos);
175        
176            * testing;
177            /*
178            %categorical(DEMB1,1,&y Boy, DEMB1 gt .z, 1);
179            %let var= DEMB1;
180            %let varlevel= 1;
181            %let text = %str(&y Boy);
182            %let denomlogic=not missing(DEMB1);
183            %let modelpos= 1;
184             */
185            %model_cat(&var);
186        
187            * use count and pct_row measures from proc freq for calculations;
188            proc freq data=derive2(where=(&denomlogic)) noprint;
189                tables flor_dyad*&var / missing outpct out=myout(keep=flor_dyad &var
190                    count pct_row where=(&var=&varlevel));
191            run;
192        
193            /*format the stats as needed*/
194            data cp;
195                set myout;
                                                                                                                         The SAS System

196                length cp_n cp_pct $20;
197                cp_n=strip(put(count,8.));
198                cp_pct=strip(put(pct_row,5.1)) || '%';
199            run;
200        
201            /* transpose twice, note use of "suffix" to distinguish */
202            proc transpose data=cp prefix=flor_dyad suffix=_n out=&var.n (drop=_name_);
203                by &var;
204                id flor_dyad;
205                var cp_n;
206            run;
207        
