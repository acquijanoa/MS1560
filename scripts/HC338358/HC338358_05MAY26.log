331        
332        * Macro to process imputed odds ratios;
333        %macro process_imputed_or(in_db=, out_db=, model=);
334            data &in_db.;
335                set &in_db.;
336                length EffectName $50;
337                if missing(Level1) then EffectName = Parameter;
338                else EffectName = catx('_', Parameter, Level1);
339            run;
340        
341            proc sort data = &in_db.;
342                by EffectName;
343            run;
344        
345            ods output ParameterEstimates = &out_db._p;
346            proc mianalyze data = &in_db.;
347                by EffectName;
348                modeleffects Estimate;
349                stderr StdErr;
350            run;
351            ods output close;
352        
353            data &out_db.(keep = order model label or_txt ci_txt pv);
354                length model $10 or_txt $20 ci_txt $30;
355                set &out_db._p(rename = (EffectName = variable));
356                model = &model.;
357        
358                %labels;
359                if variable not in ('Scale','Intercept');
360        
361                if std = 99 then do;
362                    or_txt = 'Ref.';
363                    ci_txt = ' ';
364                end;
365                else do;
366                    or_txt = strip(put(exp(estimate), 8.2));
367                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
368                                   strip(put(exp(UCLMean), 8.2)), ')');
369                end;
370            run;
                                                                               The SAS System

371        %mend process_imputed_or;
