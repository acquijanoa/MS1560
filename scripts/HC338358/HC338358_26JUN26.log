MPRINT(LABELS):   else if probt > 0.01 and probt <= 0.05 then pv = 2;
MPRINT(LABELS):   else if probt > 0.05 and probt <= 0.1 then pv = 3;
MPRINT(LABELS):   else if probt > 0.1 and probt <= 0.2 then pv = 4;
MPRINT(LABELS):   else if probt >= 0.2 then pv = 5;
