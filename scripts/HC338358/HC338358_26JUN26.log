386        
387        * Macro to process imputed odds ratios;
388        %macro process_imputed_or(in_db=, out_db=, model=);
389            data &in_db.;
390                set &in_db.;
391                length EffectName $50;
392                if missing(Level1) then EffectName = Parameter;
393                else EffectName = catx('_', Parameter, Level1);
394            run;
395        
396            proc sort data = &in_db.;
397                by EffectName;
398            run;
399        
400            ods output ParameterEstimates = &out_db._p;
401            proc mianalyze data = &in_db.;
402                by EffectName;
403                modeleffects Estimate;
404                stderr StdErr;
405            run;
406            ods output close;
407        
408            data &out_db.(keep = order model label or_txt ci_txt pv);
409                length model $10 or_txt $20 ci_txt $30;
410                set &out_db._p(rename = (EffectName = variable));
411                model = &model.;
412        
413                %labels;
414                if variable not in ('Scale','Intercept');
415        
416                if std = 99 then do;
The SAS System

417                    or_txt = 'Ref.';
418                    ci_txt = ' ';
419                end;
420                else do;
421                    or_txt = strip(put(exp(estimate), 8.2));
422                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
423                                   strip(put(exp(UCLMean), 8.2)), ')');
424                end;
425            run;
426        %mend process_imputed_or;
