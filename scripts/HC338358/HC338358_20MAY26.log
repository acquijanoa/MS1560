340        
341        * Macro to process imputed odds ratios;
342        %macro process_imputed_or(in_db=, out_db=, model=);
343            data &in_db.;
344                set &in_db.;
345                length EffectName $50;
346                if missing(Level1) then EffectName = Parameter;
347                else EffectName = catx('_', Parameter, Level1);
348            run;
349        
350            proc sort data = &in_db.;
351                by EffectName;
352            run;
353        
354            ods output ParameterEstimates = &out_db._p;
355            proc mianalyze data = &in_db.;
356                by EffectName;
357                modeleffects Estimate;
358                stderr StdErr;
359            run;
360            ods output close;
361        
362            data &out_db.(keep = order model label or_txt ci_txt pv);
363                length model $10 or_txt $20 ci_txt $30;
364                set &out_db._p(rename = (EffectName = variable));
365                model = &model.;
366        
367                %labels;
368                if variable not in ('Scale','Intercept');
369        
370                if std = 99 then do;
371                    or_txt = 'Ref.';
372                    ci_txt = ' ';
373                end;
The SAS System

374                else do;
375                    or_txt = strip(put(exp(estimate), 8.2));
376                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
377                                   strip(put(exp(UCLMean), 8.2)), ')');
378                end;
379            run;
380        %mend process_imputed_or;
