485        %macro normalize_effect(var=);
486        	%local _i _effect;
487        	%let _i=1;
488        	%do %while(%scan(&pr2_class_vars, &_i) ne );
489        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
490        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
491        		%let _i=%eval(&_i + 1);
492        	%end;
493        %mend;
