492        %macro normalize_effect(var=);
493        	%local _i _effect;
494        	%let _i=1;
495        	%do %while(%scan(&pr2_class_vars, &_i) ne );
496        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
497        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
498        		%let _i=%eval(&_i + 1);
499        	%end;
500        %mend;
