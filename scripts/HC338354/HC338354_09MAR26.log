466        %macro normalize_effect(var=);
467        	%local _i _effect;
468        	%let _i=1;
469        	%do %while(%scan(&pr2_class_vars, &_i) ne );
470        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
471        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
472        		%let _i=%eval(&_i + 1);
473        	%end;
474        %mend;
