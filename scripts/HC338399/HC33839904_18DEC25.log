1429  title 'Model 4: Model 3 + PRS';
1430  proc genmod data = &impdb;
1431      by _imputation_;
1432      class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN') marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
1433              education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO") yrsus_c3(ref='US_BORN')
1434              current_smoker(REF="NO") alcohol_use(REF="NEVER") pag2008yn(ref="YES") hei2010_c3(ref="LOW")
1435              cesd10(ref="NODEPRE") stai10(ref="NOANX");
1436      model waz = centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3 parity_v1 employedyn marital_status yrsus_c3
1437              current_smoker hei2010_c3 alcohol_use pag2008yn slpdur
1438              cesd10 stai10
1439              child_prs_bmi_a
1440              demb1 demb1 | alcohol_use  / dist = normal;
1441      format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt.
1442              employedyn employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.
1443              alcohol_use alcohol_use_fmt. current_smoker yn_fmt.
1444              pag2008yn yn_fmt. hei2010_c3 hei2010_c3_fmt.
1445              cesd10 cesd10_fmt. stai10 stai10_fmt.;
1446      ods output ParameterEstimates=genmod_results_4;
1447  run;

