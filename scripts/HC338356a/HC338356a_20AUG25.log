247        
248        %macro run_mediation(var=, covar=);
249        
250        	* Mediation Analysis;
251        	proc causalmed data = db_in;
252        		by _imputation_;
253        		class centernum(ref="BRONX") income_c2 lang_pref(ref="ENGLISH") bkgrd1_c7nomiss(ref='MEXICAN')
254        			marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED')
255        			n_hc(ref="YES") ;
256        		model waz = birthwt_ga_z &var.;
257        		mediator birthwt_ga_z = &var.;
258        		covar &adjust_var. &covar.;
259        		ods output EffectSummary = db_&var._0;
260        		format centernum centernum_fmt. income_c2 income_c2_fmt. lang_pref lang_pref_fmt. n_hc n_hc_fmt.
261        			bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn employedyn_fmt.
262        			 education_c3 education_c3_fmt. centernum centernum_fmt. alcohol_use alcohol_use_fmt. ;
263        	run;
264        
265        	* Sort dataset and exclude missing values;
                                                                               The SAS System

266        	proc sort data = db_&var._0;
267        		by Effect;
268        		where Effect ^= 'Percentage Due to Interaction';
269        	run;
270        
271        	* Combine values in the M imputed datasets;
272        	ods output ParameterEstimates = db_pooled; run;
273        	proc mianalyze data = db_&var._0;
274        		by Effect;
275        		modeleffects Estimate;
276        		stderr StdErr;
277        	run;
278        
279        	* edit dataset;
280        	data db_&var.;
281        		set db_pooled;
282        		keep Variable Eff Estimate LCLMean UCLMean;
283        		length Eff $ 8;	
284        		length variable $20;
285        		Variable = "&var.";
286        
287        		* Create Eff variable;
288        		if Effect = 'Natural Direct Effect (NDE)' then Eff='Direct';
289        		if Effect = 'Natural Indirect Effect (NIE)' then Eff='Indirect';
290        		if Effect = 'Total Effect' then Eff = 'Total';
291        
292        		* select rows in output dataset;
293        		if Eff in ('Direct','Indirect','Total');
294        run;
295        %mend run_mediation;
296        
