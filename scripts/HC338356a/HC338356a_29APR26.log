306        
307        %macro run_mediation(var=, covar=);
308        
309        	* Mediation Analysis;
310        	proc causalmed data = db_in;
311        		by _imputation_;
                                                                               The SAS System

312        		class centernum(ref="BRONX") income_c2 lang_pref(ref="ENGLISH") bkgrd1_c7nomiss(ref='MEXICAN')
313        			marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED')
314        			n_hc(ref="YES") ;
315        		model waz = birthwt_ga_z &var.;
316        		mediator birthwt_ga_z = &var.;
317        		covar &adjust_var. &covar.;
318        		ods output EffectSummary = db_&var._0;
319        		format centernum centernum_fmt. income_c2 income_c2_fmt. lang_pref lang_pref_fmt. n_hc n_hc_fmt.
320        			bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn employedyn_fmt.
321        			 education_c3 education_c3_fmt. centernum centernum_fmt. alcohol_use alcohol_use_fmt. ;
322        	run;
323        
324        	* Sort dataset and exclude missing values;
325        	proc sort data = db_&var._0;
326        		by Effect;
327        		where Effect ^= 'Percentage Due to Interaction';
328        	run;
329        
330        	* Combine values in the M imputed datasets;
331        	ods output ParameterEstimates = db_pooled; run;
332        	proc mianalyze data = db_&var._0;
333        		by Effect;
334        		modeleffects Estimate;
335        		stderr StdErr;
336        	run;
337        
338        	* edit dataset;
339        	data db_&var.;
340        		set db_pooled;
341        		keep Variable Eff Estimate LCLMean UCLMean;
342        		length Eff $ 8;	
343        		length variable $32;
344        		Variable = "&var.";
345        
346        		* Create Eff variable;
347        		if Effect = 'Natural Direct Effect (NDE)' then Eff='Direct';
348        		if Effect = 'Natural Indirect Effect (NIE)' then Eff='Indirect';
349        		if Effect = 'Total Effect' then Eff = 'Total';
350        
351        		* select rows in output dataset;
352        		if Eff in ('Direct','Indirect','Total');
353        run;
354        %mend run_mediation;
355        
356        * run the macro;
357        %run_mediation(var=YRSUS_C3_L10, covar= bmi anta10a height agg_ment agg_phys cesd10 stai10 cigarette_use_former cigarette_use_current hei2010 alcohol_use_former
357      ! alcohol_use_current pct_mvpa slpdur yrsus_c3_g10);

