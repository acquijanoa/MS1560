515        %macro normalize_effect(var=);
516        	%local _i _effect;
517        	%let _i=1;
518        	%do %while(%scan(&pr2_class_vars, &_i) ne );
519        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
520        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
521        		%let _i=%eval(&_i + 1);
522        	%end;
523        %mend;
