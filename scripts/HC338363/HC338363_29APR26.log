468        %macro normalize_effect(var=);
469        	%local _i _effect;
470        	%let _i=1;
471        	%do %while(%scan(&pr2_class_vars, &_i) ne );
472        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
473        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
474        		%let _i=%eval(&_i + 1);
475        	%end;
476        %mend;
