384        
385        * Macro to process imputed odds ratios;
386        %macro process_imputed_or(in_db=, out_db=, model=);
387            data &in_db.;
388                set &in_db.;
389                length EffectName $50;
390                if missing(Level1) then EffectName = Parameter;
391                else EffectName = catx('_', Parameter, Level1);
392            run;
393        
394            proc sort data = &in_db.;
395                by EffectName;
396            run;
397        
398            ods output ParameterEstimates = &out_db._p;
399            proc mianalyze data = &in_db.;
400                by EffectName;
401                modeleffects Estimate;
402                stderr StdErr;
403            run;
404            ods output close;
405        
406            data &out_db.(keep = order model label or_txt ci_txt pv);
407                length model $10 or_txt $20 ci_txt $30;
408                set &out_db._p(rename = (EffectName = variable));
409                model = &model.;
The SAS System

410        
411                %labels;
412                if variable not in ('Scale','Intercept');
413        
414                if std = 99 then do;
415                    or_txt = 'Ref.';
416                    ci_txt = ' ';
417                end;
418                else do;
419                    or_txt = strip(put(exp(estimate), 8.2));
420                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
421                                   strip(put(exp(UCLMean), 8.2)), ')');
422                end;
423            run;
424        %mend process_imputed_or;
