382        
383        * Macro to process imputed odds ratios;
384        %macro process_imputed_or(in_db=, out_db=, model=);
385            data &in_db.;
386                set &in_db.;
387                length EffectName $50;
388                if missing(Level1) then EffectName = Parameter;
389                else EffectName = catx('_', Parameter, Level1);
390            run;
391        
392            proc sort data = &in_db.;
393                by EffectName;
394            run;
395        
396            ods output ParameterEstimates = &out_db._p;
397            proc mianalyze data = &in_db.;
398                by EffectName;
399                modeleffects Estimate;
400                stderr StdErr;
401            run;
402            ods output close;
403        
404            data &out_db.(keep = order model label or_txt ci_txt pv);
405                length model $10 or_txt $20 ci_txt $30;
406                set &out_db._p(rename = (EffectName = variable));
407                model = &model.;
408        
The SAS System

409                %labels;
410                if variable not in ('Scale','Intercept');
411        
412                if std = 99 then do;
413                    or_txt = 'Ref.';
414                    ci_txt = ' ';
415                end;
416                else do;
417                    or_txt = strip(put(exp(estimate), 8.2));
418                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
419                                   strip(put(exp(UCLMean), 8.2)), ')');
420                end;
421            run;
422        %mend process_imputed_or;
