MPRINT(PROCESS_IMPUTED_OR):   ods output close;
MPRINT(PROCESS_IMPUTED_OR):   data or_results_4(keep = order model label or_txt ci_txt pv);
MPRINT(PROCESS_IMPUTED_OR):   length model $10 or_txt $20 ci_txt $30;
MPRINT(PROCESS_IMPUTED_OR):   set or_results_4_p(rename = (EffectName = variable));
MPRINT(PROCESS_IMPUTED_OR):   model = 4;
MPRINT(LABELS):   attrib label length = $ 150 model length = $ 10;
MPRINT(LABELS):   * categorize the p-value into 4 levels;
MPRINT(LABELS):   if probt <= 0.01 then pv = 1;
MPRINT(LABELS):   else if probt > 0.01 and probt <= 0.05 then pv = 2;
MPRINT(LABELS):   else if probt > 0.05 and probt <= 0.1 then pv = 3;
MPRINT(LABELS):   else if probt > 0.1 and probt <= 0.2 then pv = 4;
MPRINT(LABELS):   else if probt >= 0.2 then pv = 5;
MPRINT(LABELS):   * Sntadrd error negative to be formatted within parenthesis;
MPRINT(LABELS):   std = -1 * stderr;
