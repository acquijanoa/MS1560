460        * Fit the models using the imputed data;
461        title 'Model 1 - Sociodemographics';
462        proc genmod data = impdb;
463            by _imputation_;
464            class centernum(ref="BRONX") bkgrd1_c3nomiss(ref='MEXICAN') marital_status_c2(ref='SINGLE_OTHER')
465                  employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO")
466                  yrsus_c3(ref='US_BORN') bmipct_c2(ref='NORMAL');
467            model bmipct_c2 = centernum yrs_btwn_v1flor age bkgrd1_c3nomiss n_hc education_c3
468                               parity_v1 employedyn marital_status_c2 yrsus_c3 / dist = binomial;
469            format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c3nomiss bkgrd1_c3_fmt.
470                   marital_status_c2 marital_status_c2_fmt. employedyn employedyn_fmt. yrsus_c3 yrsus_c3_fmt.
471                   education_c3 education_c3_fmt. bmipct_c2 bmipct_c2_fmt.;
472            ods output ParameterEstimates = genmod_results_1;
473        run;

