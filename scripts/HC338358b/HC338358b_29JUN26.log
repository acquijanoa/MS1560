408        
409        * Macro to process imputed odds ratios;
410        %macro process_imputed_or(in_db=, out_db=, model=);
411            data &in_db.;
412                set &in_db.;
413                length EffectName $50;
414                if missing(Level1) then EffectName = Parameter;
415                else EffectName = catx('_', Parameter, Level1);
416            run;
417        
418            proc sort data = &in_db.;
419                by EffectName;
420            run;
421        
422            ods output ParameterEstimates = &out_db._p;
423            proc mianalyze data = &in_db.;
424                by EffectName;
425                modeleffects Estimate;
426                stderr StdErr;
427            run;
428            ods output close;
The SAS System

429        
430            data &out_db.(keep = order model label or_txt ci_txt pv);
431                length model $10 or_txt $20 ci_txt $30;
432                set &out_db._p(rename = (EffectName = variable));
433                model = &model.;
434        
435                %labels;
436                if variable not in ('Scale','Intercept');
437        
438                if std = 99 then do;
439                    or_txt = 'Ref.';
440                    ci_txt = ' ';
441                end;
442                else do;
443                    or_txt = strip(put(exp(estimate), 8.2));
444                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
445                                   strip(put(exp(UCLMean), 8.2)), ')');
446                end;
447            run;
448        %mend process_imputed_or;
