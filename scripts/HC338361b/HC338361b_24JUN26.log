519        %macro normalize_effect(var=);
520        	%local _i _effect;
521        	%let _i=1;
522        	%do %while(%scan(&pr2_class_vars, &_i) ne );
523        		%let _effect=%upcase(%scan(&pr2_class_vars, &_i));
524        		if index(&var, cats("&_effect","_"))=1 then &var="&_effect";
525        		%let _i=%eval(&_i + 1);
526        	%end;
527        %mend;
528        
529        * Fit the models using the imputed data;
530        title 'Model 1 - Sociodemographics';
531        proc genmod data = &impdb;
532        	by _imputation_;
533        	class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN') marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
534        			education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO") yrsus_c3(ref='US_BORN');
535        	model bmiz = centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3 parity_v1 employedyn marital_status yrsus_c3 / d=normal;
536        	format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss bkgrd1_c3nomiss_fmt. marital_status marital_status_c2_fmt.
537        			employedyn employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
538        	ods output ParameterEstimates=genmod_results_1;
539        run;

