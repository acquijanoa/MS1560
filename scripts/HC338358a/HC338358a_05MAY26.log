332        
333        * Macro to process imputed odds ratios;
334        %macro process_imputed_or(in_db=, out_db=, model=);
335            data &in_db.;
336                set &in_db.;
337                length EffectName $50;
338                if missing(Level1) then EffectName = Parameter;
339                else EffectName = catx('_', Parameter, Level1);
340            run;
341        
342            proc sort data = &in_db.;
343                by EffectName;
344            run;
345        
346            ods output ParameterEstimates = &out_db._p;
347            proc mianalyze data = &in_db.;
348                by EffectName;
349                modeleffects Estimate;
350                stderr StdErr;
351            run;
352            ods output close;
353        
354            data &out_db.(keep = order model label or_txt ci_txt pv);
355                length model $10 or_txt $20 ci_txt $30;
356                set &out_db._p(rename = (EffectName = variable));
357                model = &model.;
358        
359                %labels;
360                if variable not in ('Scale','Intercept');
361        
362                if std = 99 then do;
363                    or_txt = 'Ref.';
364                    ci_txt = ' ';
365                end;
366                else do;
367                    or_txt = strip(put(exp(estimate), 8.2));
368                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
369                                   strip(put(exp(UCLMean), 8.2)), ')');
370                end;
                                                                               The SAS System

371            run;
372        %mend process_imputed_or;
