324        
325        * Macro to process imputed odds ratios;
326        %macro process_imputed_or(in_db=, out_db=, model=);
327            data &in_db.;
328                set &in_db.;
329                length EffectName $50;
330                if missing(Level1) then EffectName = Parameter;
331                else EffectName = catx('_', Parameter, Level1);
332            run;
333        
334            proc sort data = &in_db.;
335                by EffectName;
336            run;
337        
338            ods output ParameterEstimates = &out_db._p;
339            proc mianalyze data = &in_db.;
340                by EffectName;
341                modeleffects Estimate;
342                stderr StdErr;
343            run;
344            ods output close;
345        
346            data &out_db.(keep = order model label or_txt ci_txt pv);
347                length model $10 or_txt $20 ci_txt $30;
348                set &out_db._p(rename = (EffectName = variable));
349                model = &model.;
350        
351                %labels;
352                if variable not in ('Scale','Intercept');
353        
354                if std = 99 then do;
355                    or_txt = 'Ref.';
356                    ci_txt = ' ';
357                end;
358                else do;
359                    or_txt = strip(put(exp(estimate), 8.2));
360                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
361                                   strip(put(exp(UCLMean), 8.2)), ')');
362                end;
363            run;
364        %mend process_imputed_or;
