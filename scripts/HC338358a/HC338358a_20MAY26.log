337        
338        * Macro to process imputed odds ratios;
339        %macro process_imputed_or(in_db=, out_db=, model=);
340            data &in_db.;
341                set &in_db.;
342                length EffectName $50;
343                if missing(Level1) then EffectName = Parameter;
344                else EffectName = catx('_', Parameter, Level1);
345            run;
346        
347            proc sort data = &in_db.;
348                by EffectName;
349            run;
350        
351            ods output ParameterEstimates = &out_db._p;
352            proc mianalyze data = &in_db.;
353                by EffectName;
354                modeleffects Estimate;
355                stderr StdErr;
356            run;
357            ods output close;
358        
359            data &out_db.(keep = order model label or_txt ci_txt pv);
360                length model $10 or_txt $20 ci_txt $30;
361                set &out_db._p(rename = (EffectName = variable));
362                model = &model.;
363        
364                %labels;
365                if variable not in ('Scale','Intercept');
366        
367                if std = 99 then do;
368                    or_txt = 'Ref.';
369                    ci_txt = ' ';
370                end;
371                else do;
372                    or_txt = strip(put(exp(estimate), 8.2));
373                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
The SAS System

374                                   strip(put(exp(UCLMean), 8.2)), ')');
375                end;
376            run;
377        %mend process_imputed_or;
