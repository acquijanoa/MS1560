390        title 'Model 1 - Sociodemographics';
391        proc genmod data = impdb;
392            by _imputation_;
393            class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN') marital_status(ref='SINGLE')
394                  employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="NO")
395                  yrsus_c3(ref='US_BORN') bmipct_c2(ref='NORMAL');
396            model bmipct_c2 = centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3
397                               parity_v1 employedyn marital_status yrsus_c3 / dist = binomial;
398            format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt.
399                   marital_status marital_status_fmt. employedyn employedyn_fmt. yrsus_c3 yrsus_c3_fmt.
400                   education_c3 education_c3_fmt. bmipct_c2 bmipct_c2_fmt.;
401            ods output ParameterEstimates = genmod_results_1;
402        run;

