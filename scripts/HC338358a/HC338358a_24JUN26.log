375        
376        * Macro to process imputed odds ratios;
377        %macro process_imputed_or(in_db=, out_db=, model=);
378            data &in_db.;
379                set &in_db.;
380                length EffectName $50;
381                if missing(Level1) then EffectName = Parameter;
382                else EffectName = catx('_', Parameter, Level1);
383            run;
384        
385            proc sort data = &in_db.;
386                by EffectName;
387            run;
388        
389            ods output ParameterEstimates = &out_db._p;
390            proc mianalyze data = &in_db.;
391                by EffectName;
392                modeleffects Estimate;
393                stderr StdErr;
394            run;
395            ods output close;
396        
397            data &out_db.(keep = order model label or_txt ci_txt pv);
398                length model $10 or_txt $20 ci_txt $30;
399                set &out_db._p(rename = (EffectName = variable));
400                model = &model.;
401        
402                %labels;
403                if variable not in ('Scale','Intercept');
404        
405                if std = 99 then do;
406                    or_txt = 'Ref.';
407                    ci_txt = ' ';
408                end;
409                else do;
The SAS System

410                    or_txt = strip(put(exp(estimate), 8.2));
411                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
412                                   strip(put(exp(UCLMean), 8.2)), ')');
413                end;
414            run;
415        %mend process_imputed_or;
