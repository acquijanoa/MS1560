371        
372        * Macro to process imputed odds ratios;
373        %macro process_imputed_or(in_db=, out_db=, model=);
374            data &in_db.;
375                set &in_db.;
376                length EffectName $50;
377                if missing(Level1) then EffectName = Parameter;
378                else EffectName = catx('_', Parameter, Level1);
379            run;
380        
381            proc sort data = &in_db.;
382                by EffectName;
383            run;
384        
385            ods output ParameterEstimates = &out_db._p;
386            proc mianalyze data = &in_db.;
387                by EffectName;
388                modeleffects Estimate;
389                stderr StdErr;
390            run;
391            ods output close;
392        
393            data &out_db.(keep = order model label or_txt ci_txt pv);
394                length model $10 or_txt $20 ci_txt $30;
395                set &out_db._p(rename = (EffectName = variable));
396                model = &model.;
397        
398                %labels;
399                if variable not in ('Scale','Intercept');
400        
401                if std = 99 then do;
402                    or_txt = 'Ref.';
403                    ci_txt = ' ';
404                end;
405                else do;
The SAS System

406                    or_txt = strip(put(exp(estimate), 8.2));
407                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
408                                   strip(put(exp(UCLMean), 8.2)), ')');
409                end;
410            run;
411        %mend process_imputed_or;
