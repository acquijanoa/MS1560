383        
384        * Macro to process imputed odds ratios;
385        %macro process_imputed_or(in_db=, out_db=, model=);
386            data &in_db.;
387                set &in_db.;
388                length EffectName $50;
389                if missing(Level1) then EffectName = Parameter;
390                else EffectName = catx('_', Parameter, Level1);
391            run;
392        
393            proc sort data = &in_db.;
394                by EffectName;
395            run;
396        
397            ods output ParameterEstimates = &out_db._p;
398            proc mianalyze data = &in_db.;
399                by EffectName;
400                modeleffects Estimate;
401                stderr StdErr;
402            run;
403            ods output close;
404        
405            data &out_db.(keep = order model label or_txt ci_txt pv);
406                length model $10 or_txt $20 ci_txt $30;
407                set &out_db._p(rename = (EffectName = variable));
408                model = &model.;
409        
410                %labels;
411                if variable not in ('Scale','Intercept');
412        
413                if std = 99 then do;
414                    or_txt = 'Ref.';
415                    ci_txt = ' ';
416                end;
The SAS System

417                else do;
418                    or_txt = strip(put(exp(estimate), 8.2));
419                    ci_txt = cats('(', strip(put(exp(LCLMean), 8.2)), ', ',
420                                   strip(put(exp(UCLMean), 8.2)), ')');
421                end;
422            run;
423        %mend process_imputed_or;
