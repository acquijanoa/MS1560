library(yaml)
#===============================================================================
#  Script name: generate_md.R
#  Purpose: Generate a GitHub README and a professional RTF project summary.
#===============================================================================
library(yaml)
library(glue)
library(dplyr)
# ---- Read YAML ----
yaml_file <- "project.yaml"
proj <- yaml::read_yaml(yaml_file)
meta <- proj$project
scripts <- proj$scripts
# ---- Markdown (for GitHub) ----
header <- glue("
# {meta$title}
**Project ID:** {meta$id}
**Programmer:** {meta$programmer}
**Created:** {meta$created}
**Status:** {meta$status}
---
## Project Description
{meta$description}
---
## Scripts Summary
| Code | Task |
|------|------|
")
script_rows <- vapply(
scripts,
function(s) glue("| {s$code} | {s$task} |"),
FUN.VALUE = character(1)
)
footer <- glue("
---
**Generated on:** {Sys.Date()} using `generate_md.R` by {meta$programmer}
")
# ---- Combine and save Markdown ----
md_content <- paste(header, paste(script_rows, collapse = "\n"), footer, sep = "\n")
writeLines(md_content, "README.md")
cat("✅ Markdown file 'README.md' successfully created from", yaml_file, "\n")
# ---- Generate RTF (professional layout) ----
if (Sys.which("pandoc") != "") {
cmd <- "pandoc README.md -o README.rtf --standalone --from markdown --to rtf"
system(cmd)
cat("✅ Professional 'README.rtf' created successfully.\n")
} else {
cat("⚠️ Pandoc not found. Please install Pandoc to enable RTF generation.\n")
}
#===============================================================================
