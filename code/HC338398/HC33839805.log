99         title2 height=8pt font='times' "Women (V1, SEX=0) aged 18-44 at visit 1";
100        * Merge V1 and V2;
101        *  keep women aged 18 to 44 at V1;
102        *  flag those in V1 but not at V2;
103        data id_wm_age;
104        	merge invv1.part_derv_inv5(keep=id age sex in=in_a) invv2.part_derv_v2_inv3(keep=id gender_v2 in=in_b);
105        	by id;
106        	if in_b = 1 and in_a = 1 then in_visit_2 = 1;
107        	else if  in_b = 0 then in_visit_2 = 0;
108        
109        	if (age >= 18 and age <= 44) and in_a;
110        run;

NOTE: There were 16415 observations read from the data set INVV1.PART_DERV_INV5.
NOTE: There were 11623 observations read from the data set INVV2.PART_DERV_V2_INV3.
NOTE: The data set WORK.ID_WM_AGE has 6701 observations and 5 variables.
NOTE: DATA statement used (Total process time):
