274        title 'First domain - Sociodemographics';
275        proc genmod data = &impdb;
276        	by _imputation_;
277        	class centernum(ref="BRONX") income_c2 lang_pref(ref="ENGLISH") bkgrd1_c7nomiss(ref='MEXICAN')
278        			marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED')
