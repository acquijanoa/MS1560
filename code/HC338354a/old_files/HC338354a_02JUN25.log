263        
264        * Fit the models using the imputed data;
265        title 'First domain - Sociodemographics';
266        proc genmod data = &impdb;
267        	by _imputation_;
268        	class centernum(ref="BRONX") income_c2 lang_pref(ref="ENGLISH") bkgrd1_c7nomiss(ref='MEXICAN')
269        			marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED')
270        			n_hc(ref="YES") yrsus_c3(ref='US_BORN');
271        	model waz = centernum yrs_btwn_v1flor bkgrd1_c7nomiss age income_c2 lang_pref parity_v1
272        						povpct marital_status employedyn education_c3 yrsus_c3 n_hc / d=normal;
273        	format centernum centernum_fmt. income_c2 income_c2_fmt. lang_pref lang_pref_fmt. n_hc n_hc_fmt.
274        			bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn employedyn_fmt.
275        			yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
276        	ods output ParameterEstimates=genmod_results_1;
277        run;

