268        * Fit the models using the imputed data;
269        title 'First domain - Sociodemographics';
270        proc genmod data = &impdb;
271        	by _imputation_;
272        	class centernum(ref="BRONX") income_c2 lang_pref(ref="ENGLISH") bkgrd1_c7nomiss(ref='MEXICAN')
273        			marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED')
274        			n_hc(ref="YES") yrsus_c3(ref='US_BORN');
275        	model waz = centernum yrsv1birth bkgrd1_c7nomiss age income_c2 lang_pref parity_v1
276        						povpct marital_status employedyn education_c3 yrsus_c3 n_hc / d=normal;
277        	format centernum centernum_fmt. income_c2 income_c2_fmt. lang_pref lang_pref_fmt. n_hc n_hc_fmt.
278        			bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn employedyn_fmt.
279        			yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
280        	ods output ParameterEstimates=genmod_results_1;
281        run;

