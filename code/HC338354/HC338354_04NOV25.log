298        * Fit the models using the imputed data;
299        title 'Model 1 - Sociodemographics';
300        proc genmod data = &impdb;
301        	by _imputation_;
302        	class centernum(ref="BRONX") bkgrd1_c7nomiss(ref='MEXICAN') marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED")
303        			education_c3(ref='N_HIGHSCHOOL_GED') n_hc(ref="YES") yrsus_c3(ref='US_BORN');
304        	model waz = centernum yrs_btwn_v1flor age bkgrd1_c7nomiss n_hc education_c3 parity_v1 employedyn marital_status yrsus_c3 / d=normal;
305        	format centernum centernum_fmt. n_hc n_hc_fmt. bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt.
306        			employedyn employedyn_fmt. yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
307        	ods output ParameterEstimates=genmod_results_1;
308        run;

