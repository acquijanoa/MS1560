269        * Fit the models using the imputed data;
270        title 'First domain - Sociodemographics';
271        proc genmod data = &impdb;
272        	by _imputation_;
273        	class centernum(ref="BRONX") income_c2 lang_pref(ref="ENGLISH") bkgrd1_c7nomiss(ref='MEXICAN')
274        			marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED')
275        			n_hc(ref="YES") yrsus_c3(ref='US_BORN');
276        	model waz = centernum yrsv1birth bkgrd1_c7nomiss age income_c2 lang_pref parity_v1
277        						povpct marital_status employedyn education_c3 yrsus_c3 n_hc / d=normal;
278        	format centernum centernum_fmt. income_c2 income_c2_fmt. lang_pref lang_pref_fmt. n_hc n_hc_fmt.
279        			bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn employedyn_fmt.
280        			yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
281        	ods output ParameterEstimates=genmod_results_1;
282        run;

