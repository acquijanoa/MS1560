257        
258        * Fit the models using the imputed data;
259        title 'First domain - Sociodemographics';
260        proc genmod data = &impdb;
261        	by _imputation_;
262        	class centernum(ref="BRONX") income_c2 lang_pref(ref="ENGLISH") bkgrd1_c7nomiss(ref='MEXICAN')
263        			marital_status(ref='SINGLE') employedyn(ref="NOT_EMPLOYED") education_c3(ref='N_HIGHSCHOOL_GED')
264        			n_hc(ref="YES") yrsus_c3(ref='US_BORN');
265        	model waz = centernum yrs_btwn_v1flor bkgrd1_c7nomiss age income_c2 lang_pref parity_v1
266        						povpct marital_status employedyn education_c3 yrsus_c3 n_hc / d=normal;
267        	format centernum centernum_fmt. income_c2 income_c2_fmt. lang_pref lang_pref_fmt. n_hc n_hc_fmt.
268        			bkgrd1_c7nomiss bkgrd1_c7nomiss_fmt. marital_status marital_status_fmt. employedyn employedyn_fmt.
269        			yrsus_c3 yrsus_c3_fmt. education_c3 education_c3_fmt.;
270        	ods output ParameterEstimates=genmod_results_1;
271        run;

