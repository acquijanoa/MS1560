148        	proc means data = data.&job.imputed_data_&sysdate. nmiss;
149        		by _imputation_;
150        		var &vars.;
151        		output out = a;
152        	run;
153        	proc transpose data = a out=b(drop=_label_ rename=(_name_= Variable));
154        		by _imputation_;
155        		id _stat_;
156        		var &vars.;
157        	run;
158        	proc sort data = b out=c; by Variable; run;
159        	proc print data = c; run;
160        %mend summary_imputation;
