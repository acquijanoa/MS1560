200        /*----------------------------------------------------------
201         Macro: run_univariate
202         Purpose: Run univariate models for both categorical and
203                  continuous predictors, merge results.
204        -----------------------------------------------------------*/
205        
206        %macro run_univariate(data=, outcome=, catvars=, contvars=);
207        
208        * %let data =  &impdb.;
209        * %let var = age;
210        * %let outcome = birthwt_ga_z;
211        
212           * --- categorical variables --- ;
213           %let i=1;
214           %let var0=%scan(&catvars, &i,' '); %put &var0.;
215        	   %let var = %scan(&var0,1,'-'); %put &var.;
216        	   %let ref = %scan(&var0,2,'-'); %put &ref.;
217        
218           %do %while(&var ne);
219        	* Generates the model;
220            proc mixed data = &data.;
221        		by _imputation_;
222        		class &var.(ref="&ref.");
223        		model &outcome. = &var. / solution;
224        		ods output solutionF=estimates;
225        	run;
226        
227        	* Combine imputed values;
228        	proc mianalyze parms(classvar=full)=estimates;
229        		modeleffects &var.;
230        		class &var.;
231        		ods output ParameterEstimates=est;
232        	run;
233        
234        	* edit dataset to match final output;
                                                                               The SAS System

235        	data &var._out;
236        		set est;
237        		keep source probt &var.;
238        		
239        		* create the new variable;
240        		Source = upcase(Parm);
241        		rename &var. = ClassVal0;
242        		rename probt = Prob;
243        	run;
244        		
245        	* update counter ;
246              %let i=%eval(&i+1); %put &i.;
247              %let var0=%scan(&catvars, &i, ' ');
248        	    %let var = %scan(&var0,1,'-');
249        	    %let ref = %scan(&var0,2,'-');
250           %end;
251        
252           * --- continuous variables --- ;
253           %let j=1;
254           %let var=%scan(&contvars, &j);
255        
256           %do %while(&var ne);
257        
258           proc glm data=&data;
259        	  by _imputation_;
260              ods select ParameterEstimates;
261        	  ods output ParameterEstimates = pars_est;
262              model &outcome = &var / solution;
263           run; quit;
264        
265           proc mianalyze parms= pars_est;
266        		modeleffects &var.;
267        		ods output ParameterEstimates = &var._pooled;
268           run;
269        
270           data &var._out;
271             set &var._pooled;
272             keep Source ClassVal0 ProbT;
273        
274        	 ClassVal0 = .;
275        	 rename ProbT= Prob;
276             Source = upcase(Parm);
277           run;
278        
279              * update counter ;
280        	  %let j=%eval(&j+1);
281              %let var=%scan(&contvars, &j);
282           %end;
283        
284           /* --- Merge all outputs --- */
285           data all_univariate_results;
286              set
287              %let i=1;
288              %let var0=%scan(&catvars, &i,' ');
289        	  %let var = %scan(&var0,1,'-');
290              %do %while(&var ne);
291                 &var._out
                                                                               The SAS System

292        		 %let i=%eval(&i+1);
293                 %let var0=%scan(&catvars, &i, ' ');
294        	     %let var = %scan(&var0,1,'-');
295              %end;
296        
297              %let j=1;
298              %let var=%scan(&contvars, &j);
299              %do %while(&var ne);
300                 &var._out
301                 %let j=%eval(&j+1);
302                 %let var=%scan(&contvars, &j);
303              %end;
304              ;
305           run;
306        
307           * Sort dataset;
308           proc sort data = all_univariate_results; by source classval0; run;
309           proc sort data = var_labels; by source classval0; run;
310        
311           * Insert Label by Variable;
312           data all_univariate;
313            merge all_univariate_results (in=a) var_labels (in=b);
314            by Source classval0;
315        
316        	if missing(prob) then prob = 97;
317        
318            if a;
319            if not b then label=Source;
320            run;	
321        
322        	proc sort data=all_univariate; by order; run;
323        
324        	* end macro;
325        %mend run_univariate;
