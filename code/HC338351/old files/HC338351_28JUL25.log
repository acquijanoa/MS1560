159        	LABEL INCOME_C2 = "2-level grouped yearly household income";
160        
161        	* PCT_MVPA;
162        	PCT_MVPA = mv_day / hrs_day;
163        	label PCT_MVPA = "Percentage of time spent in moderate-to-vigorous physical activity";
164        
165        	* HEI2010_C3;
166        	if missing(hei2010) then hei2010_c3 = .;
167        	else if hei2010 <= 50.1 then HEI2010_C3=1;
168        	else if hei2010 > 50.1 and hei2010 <= 62.5 then HEI2010_C3=2;
169        	else if hei2010 > 62.5 then HEI2010_C3=3;
170        	label HEI2010_C3="3-level Health Index Score 2010";
171        
172        	if in_a;
